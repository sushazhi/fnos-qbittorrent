# 统一文本文件编码处理，避免 Windows/Unix 行尾与编码问题
* text=auto

# 明确声明这些文件为 UTF-8（无 BOM），提交时不做行尾转换
*.py     text eol=lf
*.sh     text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.md     text eol=lf
manifest text eol=lf
.gitmessage text eol=lf
*.ps1    text eol=crlf

# cmd 目录下无扩展名的 shell 脚本（main、install_init 等）
cmd/*    text eol=lf

# 二进制文件
*.png    binary
*.PNG    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
