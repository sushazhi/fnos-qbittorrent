#!/bin/bash
# cmd/config_init - qBittorrent配置初始化脚本
# 功能：读取当前配置并输出为向导可识别的格式

APP_NAME="qbittorrent"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"

echo "Reading current qBittorrent configuration..."

CURRENT_UI_TYPE="vuetorrent"
CURRENT_USERNAME="admin"
HAS_CREDENTIALS="false"

if [ -f "$CONFIG_FILE" ]; then
    ALT_UI=$(grep -E "^WebUI\\\\AlternativeUIEnabled=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' \r\n')
    if [ "$ALT_UI" = "true" ]; then
        CURRENT_UI_TYPE="vuetorrent"
    elif [ "$ALT_UI" = "false" ]; then
        CURRENT_UI_TYPE="native"
    fi

    CURRENT_USERNAME=$(grep -E "^WebUI\\\\Username=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' \r\n')
    CURRENT_USERNAME="${CURRENT_USERNAME:-admin}"

    # 检测是否已有凭据（用户名+密码哈希都存在）
    CURRENT_PASS=$(grep -E "^WebUI\\\\Password_PBKDF2=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d ' \r\n')
    if [ -n "$CURRENT_PASS" ]; then
        HAS_CREDENTIALS="true"
    fi
fi

echo "wizard_ui_type=${CURRENT_UI_TYPE}"
echo "wizard_username=${CURRENT_USERNAME}"
echo "wizard_has_credentials=${HAS_CREDENTIALS}"

echo "Current configuration: UI=${CURRENT_UI_TYPE}, Username=${CURRENT_USERNAME}, HasCredentials=${HAS_CREDENTIALS}"
exit 0
