#!/bin/bash
# cmd/config_init - qBittorrent配置初始化脚本
# 功能：读取当前配置并输出为向导可识别的格式

APP_NAME="qbittorrent"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"

echo "Reading current qBittorrent configuration..."

CURRENT_UI_TYPE="vuetorrent"

if [ -f "$CONFIG_FILE" ]; then
    ALT_UI=$(grep -E "^WebUI\\\\AlternativeUIEnabled=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' \r\n')
    if [ "$ALT_UI" = "true" ]; then
        CURRENT_UI_TYPE="vuetorrent"
    elif [ "$ALT_UI" = "false" ]; then
        CURRENT_UI_TYPE="native"
    fi
fi

echo "wizard_ui_type=${CURRENT_UI_TYPE}"

echo "Current configuration: UI=${CURRENT_UI_TYPE}"
exit 0
