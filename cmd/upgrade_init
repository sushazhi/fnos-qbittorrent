#!/bin/bash
# cmd/upgrade_init - qBittorrent升级初始化脚本
# 功能：升级前停止服务并备份数据

APP_NAME="qbittorrent"
CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/qBittorrent/config"
CONFIG_FILE="${CONFIG_DIR}/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"

# 公共锁工具（锁文件位置、僵尸锁清理、退出兜底都在这里）
# shellcheck source=upgrade_lock.sh
. "${CMD_DIR}/upgrade_lock.sh" 2>/dev/null || {
    echo "错误：缺少锁工具 ${CMD_DIR}/upgrade_lock.sh" > "$TRIM_TEMP_LOGFILE"
    exit 1
}

QBT_LOCK_OWNER_TAG="upgrade_init"

# 备份到shares目录（fnOS卸载/升级时保留）
# 共享路径可能不在 /vol1（多卷系统），优先使用系统提供的共享路径
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "$SHARE_DIR" ]; then
    SHARE_DIR="/vol1/@appshare/qbittorrent"
fi
BACKUP_DIR="${SHARE_DIR}/.data_backup"
BACKUP_INFO_FILE="${SHARE_DIR}/.backup_info"

# 获取用户选择的数据处理方式
# wizard_data_action 由 wizard/upgrade 传递：keep=保留数据，delete=删除数据
DATA_ACTION="${wizard_data_action:-keep}"
echo "User data action preference: $DATA_ACTION"

echo "=================================="
echo "qBittorrent Upgrade Started"
echo "=================================="
echo ""

# 获取升级锁，防止并发升级
#   - 锁放持久目录，不随临时目录被清理而失效
#   - 先等待，再判断持有者是否存活；残留锁自动接管
#   - trap 保证任何 exit 路径都放锁
qbt_lock "qbittorrent.upgrade.lock" 20
LOCK_RC=$?
if [ "$LOCK_RC" -ne 0 ]; then
    if [ -n "${QBT_LOCK_BUSY_PID:-}" ]; then
        echo "错误：另一个升级进程正在运行（PID: ${QBT_LOCK_BUSY_PID}），请等待其完成后再试" > "$TRIM_TEMP_LOGFILE"
        echo "检测到正在运行的升级进程 PID=${QBT_LOCK_BUSY_PID}，升级已中止"
    else
        echo "错误：升级锁被占用且无法自动清理，请重启 NAS 后重试" > "$TRIM_TEMP_LOGFILE"
        echo "升级锁被占用（持有者已退出但锁未释放），无法自动接管"
    fi
    exit 1
fi

# 停止服务
echo "[1/3] Stopping ${APP_NAME} service..."

# 使用绝对路径调用main脚本停止服务
MAIN_SCRIPT="${CMD_DIR}/main"
STOPPED=false

if [ -x "$MAIN_SCRIPT" ]; then
    "$MAIN_SCRIPT" stop && STOPPED=true || echo "Main stop failed or already stopped"
elif [ -f "$PID_FILE" ]; then
    # 如果脚本不存在，直接通过PID停止
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
        echo "Stopping process (PID: $PID)..."
        kill "$PID" 2>/dev/null || true

        # 等待进程结束（最多10秒）
        TIMEOUT=10
        while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
            sleep 0.5
            TIMEOUT=$((TIMEOUT - 1))
        done

        # 强制终止如果还在运行
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "Force killing process..."
            kill -9 "$PID" 2>/dev/null || true
            sleep 0.5
        fi
    fi
fi

# 清理PID文件
rm -f "$PID_FILE"

# 验证本应用服务是否已停止（通过 profile 路径区分）
PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
    echo "错误：服务停止失败，进程仍在运行（PID: $PID）" > "$TRIM_TEMP_LOGFILE"
    echo "错误：无法停止正在运行的服务，升级已中止"
    exit 1
fi

if [ "$STOPPED" = true ]; then
    echo "服务已成功停止"
else
    echo "服务已处于停止状态"
fi

# 处理数据
echo "[2/3] Processing data based on user preference..."

if [ "$DATA_ACTION" = "delete" ]; then
    # 用户选择删除所有数据
    echo "User chose to delete all data during upgrade"
    if [ -d "$DATA_DIR" ]; then
        # 只清内容，保留目录骨架（目录本身由 fnOS 管理）
        find "$DATA_DIR" -mindepth 1 -maxdepth 1 ! -name '.locks' -exec rm -rf {} + 2>/dev/null || true
        echo "Data directory cleared: $DATA_DIR"
    fi
    # 清理可能存在的备份
    rm -rf "$BACKUP_DIR" 2>/dev/null || true
else
    # 用户选择保留数据 - 主动备份到持久化目录以防被fnOS清理
    echo "User chose to keep data, backing up to persistent location..."

    if [ -d "$DATA_DIR" ] && [ -n "$(ls -A "$DATA_DIR" 2>/dev/null | grep -v '^\.locks$')" ]; then
        # 创建备份目录：先清再建，避免连续升级时 cp -a 嵌套成 backup/config/...
        if ! rm -rf "$BACKUP_DIR" 2>/dev/null; then
            echo "错误：清理旧备份目录失败" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        if ! mkdir -p "$BACKUP_DIR" 2>/dev/null; then
            echo "错误：创建备份目录失败" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi

        # 复制所有数据到备份目录。
        #
        # 关键：qBittorrent 会把配置目录权限设为 000 (d---------)，防止外部篡改。
        # 此时 cp -a 连目录都进不去，备份目录会是空的 —— 这正是
        # "备份验证失败，数据可能存在风险" 的真实成因。
        # 因此先临时放开读/执行权限，备份完成后立刻还原原权限。
        #
        # 用数字权限记录原始 mode，还原时精确恢复，不改变用户安全设置。
        #
        # 顺序很关键：必须在任何 chmod 之前记录原始权限，否则记到的是被改过的值。
        # find 默认无法进入 000 权限目录，但去掉 -prune 后仍需可遍历；
        # 因此采用「先记录已知层级 + 放开后再补记录」的两段式：
        #   1) 逐个 depth 递增地记录（父目录先放开，才能 stat 到子项）
        # 这里用更简单的等价做法：先用 -maxdepth 1 记录顶层，再放开，再全量记录。
        _perm_list=$(mktemp 2>/dev/null || echo "/tmp/qbt_perm.$$")

        # 记录原始权限：对每层目录先 stat 再进入。
        # 用一个递归 shell 函数实现，遇到无权限目录时先记录其现有 mode（即 000）再放开进入。
        _qbt_dump_perms() {
            local d="$1"
            [ -d "$d" ] || return 0
            local m
            m=$(stat -c '%a' "$d" 2>/dev/null) || return 0
            printf '%s %s\n' "$m" "$d" >> "$_perm_list"
            # 放开当前层，才能继续往里走
            chmod u+rX "$d" 2>/dev/null || true
            local sub
            for sub in "$d"/*/; do
                [ -d "$sub" ] || continue
                _qbt_dump_perms "${sub%/}"
            done
        }
        _qbt_dump_perms "$DATA_DIR" 2>/dev/null || true

        # 文件若不可读也一并放开（cp 需要读内容）
        find "$DATA_DIR" -type f -exec chmod u+r {} \; 2>/dev/null || true

        BACKUP_OK=false
        if cp -a "$DATA_DIR"/. "$BACKUP_DIR"/ 2>/dev/null; then
            BACKUP_OK=true
        else
            echo "警告：cp -a 返回非 0，检查关键数据是否已备份"
        fi

        # 还原原始目录权限（逐条精确还原到升级前的 mode）
        if [ -s "$_perm_list" ]; then
            while IFS=' ' read -r _mode _path; do
                [ -n "$_mode" ] && [ -e "$_path" ] && \
                    chmod "$_mode" "$_path" 2>/dev/null || true
            done < "$_perm_list"
        fi
        rm -f "$_perm_list" 2>/dev/null || true

        # 清理备份里的运行时锁目录（不是用户数据）
        rm -rf "${BACKUP_DIR}/.locks" 2>/dev/null || true
        # 备份里的目录权限恢复为可读写，避免还原时同样遇到 000 权限
        find "$BACKUP_DIR" -type d -exec chmod 700 {} \; 2>/dev/null || true
        find "$BACKUP_DIR" -type f -exec chmod 600 {} \; 2>/dev/null || true

        # 验证备份：只要有任一实际用户数据到位即视为成功
        VERIFIED=false
        if [ -f "${BACKUP_DIR}/qBittorrent/config/qBittorrent.conf" ]; then
            VERIFIED=true
        elif [ -d "${BACKUP_DIR}/qBittorrent" ] && [ -n "$(ls -A "${BACKUP_DIR}/qBittorrent" 2>/dev/null)" ]; then
            VERIFIED=true
        elif [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
            VERIFIED=true
        fi

        if [ "$VERIFIED" = true ]; then
            echo "Data backed up successfully to: $BACKUP_DIR"
            # 备份信息写入持久化位置
            echo "BACKUP_DIR=$BACKUP_DIR" > "$BACKUP_INFO_FILE"
            echo "Backup location recorded: $BACKUP_INFO_FILE"
        elif [ "$BACKUP_OK" = true ]; then
            # cp 成功但备份目录仍为空：源数据实际只有 .locks，无可备份内容
            echo "无实际用户数据需要备份（仅有运行时目录）"
        else
            echo "错误：备份验证失败，数据可能存在风险" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
    else
        echo "No existing data to backup or data directory is empty"
    fi
fi

echo ""
echo "=================================="
echo "qBittorrent upgrade initialized"
echo "=================================="

# 释放升级锁（trap 也会兜底，这里显式释放以缩短锁持有窗口）
qbt_unlock
exit 0
