#!/bin/bash
# cmd/main - qBittorrent应用生命周期管理脚本

APP_NAME="qbittorrent"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
PROXY_PID_FILE="${TRIM_PKGTMP}/${APP_NAME}-proxy.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"

PROXY_SCRIPT="${BIN_DIR}/gateway-proxy.py"
GATEWAY_SOCK="${TRIM_APPDEST}/qbittorrent.sock"

LOG_MAX_SIZE=1048576
LOG_MAX_FILES=3

WEBUI_PORT="8080"

rotate_logs() {
    if [ -f "$LOG_FILE" ]; then
        LOG_SIZE=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$LOG_SIZE" -gt "$LOG_MAX_SIZE" ]; then
            if [ -f "${LOG_FILE}.${LOG_MAX_FILES}" ]; then
                rm -f "${LOG_FILE}.${LOG_MAX_FILES}"
            fi
            for i in $(seq $((LOG_MAX_FILES - 1)) -1 1); do
                if [ -f "${LOG_FILE}.${i}" ]; then
                    mv "${LOG_FILE}.${i}" "${LOG_FILE}.$((i + 1))"
                fi
            done
            mv "$LOG_FILE" "${LOG_FILE}.1"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Log rotated" > "$LOG_FILE"
        fi
    fi
}

read_qbt_port() {
    if [ -f "$CONFIG_FILE" ]; then
        PORT_FROM_CONFIG=$(grep -E "^WebUI\\\\Port=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2 | tr -d ' \r\n')
        if [ -n "$PORT_FROM_CONFIG" ] && [ "$PORT_FROM_CONFIG" -gt 0 ] 2>/dev/null; then
            WEBUI_PORT="$PORT_FROM_CONFIG"
        fi
    fi
}

start_proxy() {
    if [ -f "$PROXY_PID_FILE" ]; then
        local PROXY_PID=$(cat "$PROXY_PID_FILE")
        if kill -0 "$PROXY_PID" 2>/dev/null; then
            echo "proxy is already running (PID: $PROXY_PID)"
            return 0
        fi
        rm -f "$PROXY_PID_FILE"
    fi

    rm -f "$GATEWAY_SOCK"
    read_qbt_port

    if [ ! -f "$PROXY_SCRIPT" ]; then
        echo "Warning: proxy script not found at $PROXY_SCRIPT, gateway proxy unavailable"
        return 1
    fi

    python3 "$PROXY_SCRIPT" "$GATEWAY_SOCK" 127.0.0.1 "$WEBUI_PORT" "$CONFIG_FILE" >> "$LOG_FILE" 2>&1 &

    PROXY_PID=$!
    echo $PROXY_PID > "$PROXY_PID_FILE"

    # 短时等待 socket 就绪（最长 0.5s）
    local wait=0
    while [ $wait -lt 5 ] && ! [ -S "$GATEWAY_SOCK" ]; do
        sleep 0.1
        wait=$((wait + 1))
    done

    if kill -0 "$PROXY_PID" 2>/dev/null && [ -S "$GATEWAY_SOCK" ]; then
        echo "proxy started (PID: $PROXY_PID), gateway: ${GATEWAY_SOCK} -> 127.0.0.1:${WEBUI_PORT}"
        return 0
    fi

    echo "Warning: proxy failed to start, gateway proxy unavailable"
    rm -f "$PROXY_PID_FILE"
    rm -f "$GATEWAY_SOCK"
    return 1
}

stop_proxy() {
    if [ -f "$PROXY_PID_FILE" ]; then
        local PROXY_PID=$(cat "$PROXY_PID_FILE" 2>/dev/null)
        if kill -0 "$PROXY_PID" 2>/dev/null; then
            kill "$PROXY_PID" 2>/dev/null || true
            sleep 1
            if kill -0 "$PROXY_PID" 2>/dev/null; then
                kill -9 "$PROXY_PID" 2>/dev/null || true
            fi
        fi
        rm -f "$PROXY_PID_FILE"
    fi
    rm -f "$GATEWAY_SOCK"
    echo "proxy stopped"
}

case "$1" in
start)
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "${APP_NAME} is already running (PID: $PID)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    EXISTING_PID=$(pgrep -f "qbittorrent-nox" 2>/dev/null | head -1)
    if [ -n "$EXISTING_PID" ]; then
        EXISTING_CMD=$(ps -p "$EXISTING_PID" -o args= 2>/dev/null)
        if echo "$EXISTING_CMD" | grep -q "profile.*${DATA_DIR}"; then
            echo $EXISTING_PID > "$PID_FILE"
            echo "${APP_NAME} is already running (PID: $EXISTING_PID, recovered)"
            exit 0
        fi
        echo "提示：检测到其他 qBittorrent 进程正在运行 (PID: $EXISTING_PID)，继续启动本应用"
    fi

    mkdir -p "$(dirname "$PID_FILE")" "${DATA_DIR}/qBittorrent/config" "$(dirname "$LOG_FILE")"

    rotate_logs

    # 清理 qBittorrent 内部日志的冗余备份文件（无限递增，无数量上限）
    QB_LOG_DIR="${DATA_DIR}/qBittorrent/data/logs"
    if [ -d "$QB_LOG_DIR" ]; then
        find "$QB_LOG_DIR" -name "qbittorrent.log.bak*" -type f -delete
    fi

    if [ ! -f "$BIN_DIR/qbittorrent-nox" ]; then
        echo "错误：未找到可执行文件 qbittorrent-nox" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if [ ! -x "$BIN_DIR/qbittorrent-nox" ]; then
        chmod +x "$BIN_DIR/qbittorrent-nox"
    fi

    if [ ! -f "$CONFIG_FILE" ]; then
        # 首次启动默认凭证（仅当未通过安装向导创建配置文件时的回退）
        # 正常安装流程中，install_callback 已通过向导密码创建配置文件
        DEFAULT_PASS_HASH='@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)'

        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=127.0.0.1
WebUI\Port=${WEBUI_PORT}
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=${DEFAULT_PASS_HASH}
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
[Application]
FileLogger\Backup=false
EOF
    fi

    SAVE_PATH=$(grep -E "(Session\\\\DefaultSavePath|Downloads\\\\SavePath)=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2-)
    if [ -n "$SAVE_PATH" ]; then
        if [ ! -d "$SAVE_PATH" ]; then
            if echo "$SAVE_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
                mkdir -p "$SAVE_PATH" 2>/dev/null && echo "已创建下载目录：$SAVE_PATH" >> "$LOG_FILE" || echo "警告：无法创建下载目录（$SAVE_PATH），请前往【系统设置 - 应用 - qBittorrent】设置允许访问的文件夹" >> "$LOG_FILE"
            else
                echo "警告：下载目录（$SAVE_PATH）不存在，请在 fnOS 文件管理中创建" >> "$LOG_FILE"
            fi
        elif [ ! -r "$SAVE_PATH" ] || [ ! -w "$SAVE_PATH" ]; then
            echo "警告：下载目录（$SAVE_PATH）没有读写权限，请前往【系统设置 - 应用 - qBittorrent】设置允许访问的文件夹" >> "$LOG_FILE"
        fi
    fi

    TEMP_PATH=$(grep -E "^Session\\\\TempPath=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2-)
    if [ -n "$TEMP_PATH" ] && [ ! -d "$TEMP_PATH" ]; then
        if echo "$TEMP_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
            mkdir -p "$TEMP_PATH" 2>/dev/null || true
        fi
    fi

    export QT_QPA_PLATFORM=offscreen

    echo "Starting qBittorrent..."
    "$BIN_DIR/qbittorrent-nox" \
        --confirm-legal-notice \
        --profile="${DATA_DIR}" \
        --webui-port="$WEBUI_PORT" \
        >> "$LOG_FILE" 2>&1 &

    PID=$!
    echo $PID > "$PID_FILE"

    # 尽早启动代理，与 qBittorrent 并行初始化
    # 代理会等待 qBittorrent WebUI 就绪后才接受请求
    start_proxy &
    PROXY_PID=$!

    # 短等待后检测进程是否存活（最长 3s，按 0.2s 间隔检测）
    elapsed=0
    while [ $elapsed -lt 30 ]; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        # 存活超过 0.6s 即可认为启动成功，提前跳出
        if [ $elapsed -ge 6 ]; then
            break
        fi
        sleep 0.1
        elapsed=$((elapsed + 1))
    done

    if ! ps -p "$PID" > /dev/null 2>&1; then
        if [ -f "$LOG_FILE" ]; then
            if grep -qi "port.*already\|bind.*failed\|address.*in.*use" "$LOG_FILE" 2>/dev/null; then
                echo "错误：端口 ${WEBUI_PORT} 被其他程序占用" > "$TRIM_TEMP_LOGFILE"
                rm -f "$PID_FILE"
                exit 1
            fi
        fi
        echo "错误：${APP_NAME} 启动失败" > "$TRIM_TEMP_LOGFILE"
        if [ -f "$LOG_FILE" ]; then
            tail -20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE"
        fi
        rm -f "$PID_FILE"
        exit 1
    fi

    echo "${APP_NAME} started (PID: $PID)"

    # 等待 start_proxy 子 shell 完成（不 wait qbittorrent-nox 守护进程）
    if [ -n "$PROXY_PID" ]; then
        wait $PROXY_PID 2>/dev/null || true
    fi

    exit 0
    ;;

stop)
    stop_proxy

    PID=""
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
    fi
    if [ -z "$PID" ] || ! ps -p "$PID" > /dev/null 2>&1; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
    fi

    if [ -z "$PID" ]; then
        echo "${APP_NAME} is not running"
        exit 0
    fi

    echo "Stopping ${APP_NAME} (PID: $PID)..."
    kill "$PID" 2>/dev/null || true

    TIMEOUT=10
    while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
        sleep 0.5
        TIMEOUT=$((TIMEOUT - 1))
    done

    if ps -p "$PID" > /dev/null 2>&1; then
        kill -9 "$PID" 2>/dev/null || true
    fi

    rm -f "${TRIM_PKGTMP}/${APP_NAME}.pid" 2>/dev/null
    echo "${APP_NAME} stopped"
    exit 0
    ;;

restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;

status)
    RUNNING=false
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            RUNNING=true
        fi
    fi
    if [ "$RUNNING" = false ]; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
        if [ -n "$PID" ]; then
            RUNNING=true
        fi
    fi

    if [ "$RUNNING" = true ]; then
        echo "${APP_NAME} is running (PID: $PID)"
        exit 0
    else
        echo "${APP_NAME} is not running"
        exit 3
    fi
    ;;

*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
