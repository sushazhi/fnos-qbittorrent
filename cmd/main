#!/bin/bash
# cmd/main - qBittorrent应用生命周期管理脚本

APP_NAME="qbittorrent"
# 生命周期脚本由 fnOS 传入该变量；脱离宿主手工调用时给个兜底，
# 避免 echo ... > "" 静默丢错误信息
TRIM_TEMP_LOGFILE="${TRIM_TEMP_LOGFILE:-/tmp/${APP_NAME}-lifecycle.log}"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"
LOCK_FILE="${DATA_DIR}/qBittorrent/config/lockfile"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
PROXY_PID_FILE="${TRIM_PKGTMP}/${APP_NAME}-proxy.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"

PROXY_SCRIPT="${BIN_DIR}/gateway-proxy.py"
GATEWAY_SOCK="${TRIM_APPDEST}/qbittorrent.sock"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 公共的 profile 权限 / 实例锁自愈逻辑（upgrade_callback 也用它，保证口径一致）
# shellcheck source=profile_acl.sh
. "${SCRIPT_DIR}/profile_acl.sh" 2>/dev/null || true

LOG_MAX_SIZE=1048576
LOG_MAX_FILES=3

WEBUI_PORT="8080"
WEBUI_ADDRESS="0.0.0.0"
WEBUI_PORT_SCAN=100   # 端口被占用时，最多向后顺延探测多少个端口

rotate_logs() {
    if [ -f "$LOG_FILE" ]; then
        LOG_SIZE=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$LOG_SIZE" -gt "$LOG_MAX_SIZE" ]; then
            if [ -f "${LOG_FILE}.${LOG_MAX_FILES}" ]; then
                rm -f "${LOG_FILE}.${LOG_MAX_FILES}"
            fi
            for i in $(seq $((LOG_MAX_FILES - 1)) -1 1); do
                if [ -f "${LOG_FILE}.${i}" ]; then
                    mv "${LOG_FILE}.${i}" "${LOG_FILE}.$((i + 1))"
                fi
            done
            mv "$LOG_FILE" "${LOG_FILE}.1"
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Log rotated" > "$LOG_FILE"
        fi
    fi
}

read_qbt_port() {
    [ -f "$CONFIG_FILE" ] || return 0
    # 权威写法是 [WebUI] 段里的 Port=；同时兼容历史遗留的 WebUI\Port= 形式。
    # 老实现只认 WebUI\Port=，而 qBittorrent 自己写的是 [WebUI] 段内的 Port=，
    # 于是用户在 WebUI 里改过的端口读不回来，启动时又被打回默认值。
    PORT_FROM_CONFIG=$(awk '
        /^\[/ { in_webui = ($0 == "[WebUI]"); next }
        in_webui && /^[ \t]*Port=/ { sub(/^[ \t]*Port=/, ""); v = $0; exit }
        /^[ \t]*WebUI\\Port=/ { sub(/^[ \t]*WebUI\\Port=/, ""); v = $0 }
        END { if (v != "") print v }
    ' "$CONFIG_FILE" 2>/dev/null | tr -d ' \r\n')
    case "$PORT_FROM_CONFIG" in
        ''|*[!0-9]*) return 0 ;;
    esac
    if [ "$PORT_FROM_CONFIG" -ge 1024 ] && [ "$PORT_FROM_CONFIG" -le 65535 ]; then
        WEBUI_PORT="$PORT_FROM_CONFIG"
    fi
}

# 判断 $1:$2 能否被绑定。qBittorrent 就监听在这个地址上，
# 用真实 bind 探测比“能否连上”更贴近实际语义（监听中的端口一定 bind 失败）。
# 带 SO_REUSEADDR 与 qBittorrent 行为一致：TIME_WAIT 残留不会误判成占用。
port_available() {
    local addr="$1"
    local port="$2"
    case "$addr" in
        ''|'*') addr="0.0.0.0" ;;
    esac
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$addr" "$port" >/dev/null 2>&1 <<'PY'
import errno
import socket
import sys

sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
try:
    sock.bind((sys.argv[1], int(sys.argv[2])))
except OSError as exc:
    # 2 = 地址本身有问题（例如配了个本机没有的 IP），不该算成“被占用”
    sys.exit(2 if exc.errno != errno.EADDRINUSE else 1)
finally:
    sock.close()
PY
        case "$?" in
            0) return 0 ;;   # 能 bind：空闲
            1) return 1 ;;   # EADDRINUSE：被占用
            *) return 0 ;;   # 地址不可绑等异常：不归因于占用，交给 qBittorrent 报真实错误
        esac
    fi
    # 退化为“能否连上”：有服务在监听即视为占用；
    # 连不上或环境不支持 /dev/tcp 时按空闲处理（宁可启动失败并报出真实原因，
    # 也不要把可用端口误判成被占用而白白顺延）
    if (exec 3<>"/dev/tcp/${addr}/${port}") >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

# 网关模式下 WebUI 端口只是代理与本机 qBittorrent 之间的内部端口，
# 与其他应用/容器撞车时顺延一个可用端口即可，不能因此让应用启动失败。
resolve_webui_port() {
    local port="$1"
    local last=$((port + WEBUI_PORT_SCAN))
    while [ "$port" -le "$last" ]; do
        if port_available "$WEBUI_ADDRESS" "$port"; then
            echo "$port"
            return 0
        fi
        port=$((port + 1))
    done
    return 1
}

# 把端口写回 qBittorrent 配置，保证重启后代理读取到的端口与 qBittorrent 一致。
# 只改 [WebUI] 段内的 Port=，并顺手丢弃历史遗留的 WebUI\Port= 重复键：
# 那些键落在 [WebUI] 段里会被解析成 WebUI\WebUI\Port，既无效又把配置搅乱。
set_config_port() {
    local port="$1"
    local tmp_file="${CONFIG_FILE}.port.$$"
    awk -v p="$port" '
        BEGIN { in_webui = 0; seen_webui = 0; wrote = 0 }
        /^\[/ {
            if (in_webui && !wrote) { print "Port=" p; wrote = 1 }
            in_webui = ($0 == "[WebUI]")
            if (in_webui) seen_webui = 1
            print
            next
        }
        /^[ \t]*WebUI\\Port=/ { next }
        in_webui && /^[ \t]*Port=/ {
            if (!wrote) { print "Port=" p; wrote = 1 }
            next
        }
        { print }
        END {
            if (in_webui && !wrote) { print "Port=" p }
            if (!seen_webui) { print "[WebUI]"; print "Port=" p }
        }
    ' "$CONFIG_FILE" > "$tmp_file" 2>/dev/null && mv "$tmp_file" "$CONFIG_FILE"
    rm -f "$tmp_file"
}

# 老版本 bug 会把 WebUI\Port= 写进 [WebUI] 段，解析后变成 WebUI\WebUI\Port：
# 既是废键，又让人误以为端口配了两处。发现就顺手规范化一次。
normalize_config_port() {
    [ -f "$CONFIG_FILE" ] || return 0
    if awk '
        /^\[/ { in_webui = ($0 == "[WebUI]"); next }
        in_webui && /^[ \t]*WebUI\\Port=/ { found = 1 }
        END { exit(found ? 0 : 1) }
    ' "$CONFIG_FILE" 2>/dev/null; then
        set_config_port "$WEBUI_PORT" && echo '已规范化配置中的重复端口键（[WebUI] 段内的 WebUI\Port=）'
    fi
}

read_qbt_address() {
    local addr
    addr=$(grep -E "^[ \t]*(WebUI\\\\)?Address=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2- | tr -d ' \r\n')
    [ -n "$addr" ] && WEBUI_ADDRESS="$addr"
}

# 残留实例锁与 profile ACL 的具体修复逻辑放在 cmd/profile_acl.sh，
# 与升级流程共用同一份实现（升级后不修默认 ACL 正是启动秒退的来源）。
clean_stale_lockfile() {
    if declare -F qbt_clean_profile_lock > /dev/null 2>&1; then
        qbt_clean_profile_lock "$DATA_DIR"
        return 0
    fi
    [ -f "$LOCK_FILE" ] || return 0
    local stale_pid=""
    [ -r "$LOCK_FILE" ] && stale_pid=$(head -1 "$LOCK_FILE" 2>/dev/null | tr -cd '0-9')
    if [ -n "$stale_pid" ] && ps -p "$stale_pid" > /dev/null 2>&1; then
        echo "提示：实例锁仍被存活进程 ${stale_pid} 持有，暂不清理"
        return 0
    fi
    rm -f "$LOCK_FILE" 2>/dev/null && echo "已清理残留实例锁：$LOCK_FILE"
}

repair_profile_acls() {
    if declare -F qbt_repair_profile_acls > /dev/null 2>&1; then
        qbt_repair_profile_acls "$DATA_DIR"
    fi
    return 0
}

kill_orphan_proxies() {
    # 清理所有残留的 gateway-proxy 进程（防止历史孤儿进程堆积占用内存）
    # 匹配本应用专用的 GATEWAY_SOCK，避免误杀其他应用
    local orphans
    orphans=$(pgrep -f "gateway-proxy.py.*${GATEWAY_SOCK}" 2>/dev/null)
    for pid in $orphans; do
        # 跳过本次要启动的 PID 文件记录
        if [ -f "$PROXY_PID_FILE" ] && [ "$pid" = "$(cat "$PROXY_PID_FILE" 2>/dev/null)" ]; then
            continue
        fi
        kill -9 "$pid" 2>/dev/null && echo "清理残留代理进程 PID: $pid"
    done
}

kill_orphan_mcps() {
    # MCP 由代理托管；代理被强杀后 MCP 会沦为孤儿并一直占着 8082，
    # 新实例绑不上端口只在日志里留下 Errno 98 的报错，很容易被误读成
    # “WebUI 端口被占用”。启动新代理前先清干净。
    pkill -f "mcp-server.py.*--config ${CONFIG_FILE}" 2>/dev/null || true
}

start_proxy() {
    # 先清理所有残留的同名代理进程，再启动新实例，避免多个进程堆积
    kill_orphan_proxies

    # TRIM_PKGTMP 可能被升级/重装清空，写 PID 文件前必须确保目录存在
    mkdir -p "$(dirname "$PROXY_PID_FILE")" 2>/dev/null || true

    if [ -f "$PROXY_PID_FILE" ]; then
        local PROXY_PID=$(cat "$PROXY_PID_FILE")
        if kill -0 "$PROXY_PID" 2>/dev/null; then
            echo "proxy is already running (PID: $PROXY_PID)"
            return 0
        fi
        rm -f "$PROXY_PID_FILE"
    fi

    rm -f "$GATEWAY_SOCK"
    read_qbt_port
    kill_orphan_mcps

    if [ ! -f "$PROXY_SCRIPT" ]; then
        echo "Warning: proxy script not found at $PROXY_SCRIPT, gateway proxy unavailable"
        return 1
    fi

    python3 "$PROXY_SCRIPT" "$GATEWAY_SOCK" 127.0.0.1 "$WEBUI_PORT" "$CONFIG_FILE" >> "$LOG_FILE" 2>&1 &

    PROXY_PID=$!
    echo $PROXY_PID > "$PROXY_PID_FILE"

    # 等待 socket 就绪（最长 3s）：代理启动时要做版本探测等初始化，
    # 0.5s 不够，历史上会稳定刷出“proxy failed to start”的假告警
    local wait=0
    while [ $wait -lt 30 ] && ! [ -S "$GATEWAY_SOCK" ]; do
        sleep 0.1
        wait=$((wait + 1))
    done

    if kill -0 "$PROXY_PID" 2>/dev/null && [ -S "$GATEWAY_SOCK" ]; then
        echo "proxy started (PID: $PROXY_PID), gateway: ${GATEWAY_SOCK} -> 127.0.0.1:${WEBUI_PORT}"
        return 0
    fi

    echo "Warning: proxy failed to start, gateway proxy unavailable"
    rm -f "$PROXY_PID_FILE"
    rm -f "$GATEWAY_SOCK"
    return 1
}

stop_proxy() {
    if [ -f "$PROXY_PID_FILE" ]; then
        local PROXY_PID=$(cat "$PROXY_PID_FILE" 2>/dev/null)
        if kill -0 "$PROXY_PID" 2>/dev/null; then
            kill "$PROXY_PID" 2>/dev/null || true
            sleep 1
            if kill -0 "$PROXY_PID" 2>/dev/null; then
                kill -9 "$PROXY_PID" 2>/dev/null || true
            fi
        fi
        rm -f "$PROXY_PID_FILE"
    fi
    # 兜底：清理所有残留的同名代理进程，确保不留孤儿
    pkill -f "gateway-proxy.py.*${GATEWAY_SOCK}" 2>/dev/null || true
    rm -f "$GATEWAY_SOCK"
    echo "proxy stopped"
}

# MCP 服务进程由 gateway-proxy 托管（启动/热重启见其内部 _ensure_mcp_proc），
# 这里仅在停止流程做兜底清理，防止 proxy 被 kill -9 后 MCP 沦为孤儿
stop_mcp() {
    pkill -f "mcp-server.py.*--config ${CONFIG_FILE}" 2>/dev/null || true
}

case "$1" in
start)
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "${APP_NAME} is already running (PID: $PID)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    # 只匹配本应用的实例（通过 --profile 限定数据目录），
    # 避免把系统上其他 qBittorrent 应用（如 trim.qbittorrent）误判为本应用
    EXISTING_PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
    if [ -n "$EXISTING_PID" ]; then
        EXISTING_CMD=$(ps -p "$EXISTING_PID" -o args= 2>/dev/null)
        if echo "$EXISTING_CMD" | grep -q "profile.*${DATA_DIR}"; then
            # 恢复分支也必须保证运行时目录存在：
            # 升级/重装可能清空 TRIM_PKGTMP，写 PID 文件会失败，
            # 之后 stop 找不到进程，升级就无法正常停止服务。
            mkdir -p "$(dirname "$PID_FILE")" 2>/dev/null || true
            echo $EXISTING_PID > "$PID_FILE" 2>/dev/null || true
            echo "${APP_NAME} is already running (PID: $EXISTING_PID, recovered)"
            # 恢复分支也要确保日志文件存在：升级/重装可能清空过数据目录，
            # 而存活进程持有的是已删除的旧日志 fd，不会自动重建文件
            mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
            echo "$(date '+%Y-%m-%d %H:%M:%S') - Reattached to running process (PID: $EXISTING_PID), log file recreated" >> "$LOG_FILE" 2>/dev/null || true
            # start_proxy 自身是幂等的：代理已在运行则直接返回，
            # socket 残留/PID 文件过期等异常情况也会自行清理后重启
            start_proxy
            exit 0
        fi
        echo "提示：检测到其他 qBittorrent 进程正在运行 (PID: $EXISTING_PID)，继续启动本应用"
    fi

    # 读取配置文件中的 WebUI 端口：用户可能在 WebUI 中修改过端口，
    # 若仍用默认 8080 启动会覆盖用户设置，导致端口配置丢失
    read_qbt_port
    normalize_config_port
    read_qbt_address
    mkdir -p "$(dirname "$PID_FILE")" "${DATA_DIR}/qBittorrent/config" "$(dirname "$LOG_FILE")"

    # 目录默认 ACL 缺失/损坏会让 qBittorrent 写出的文件自己都读不了，先修一遍
    repair_profile_acls

    rotate_logs

    # 清理 qBittorrent 内部日志的冗余备份文件（无限递增，无数量上限）
    QB_LOG_DIR="${DATA_DIR}/qBittorrent/data/logs"
    if [ -d "$QB_LOG_DIR" ]; then
        find "$QB_LOG_DIR" -name "qbittorrent.log.bak*" -type f -delete
    fi

    if [ ! -f "$BIN_DIR/qbittorrent-nox" ]; then
        echo "错误：未找到可执行文件 qbittorrent-nox" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if [ ! -x "$BIN_DIR/qbittorrent-nox" ]; then
        chmod +x "$BIN_DIR/qbittorrent-nox"
    fi

    if [ ! -f "$CONFIG_FILE" ]; then
        # 首次启动兜底：动态生成随机内部凭证（SSO 网关免密）
        # 正常安装流程中，install_callback 已创建配置；此处仅作极端兜底，绝不使用公开默认密码
        BOOT_PASS_HASH=''
        BOOT_RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        if [ -n "$BOOT_RANDOM_PASS" ] && [ -f "$BIN_DIR/qbt_password.py" ]; then
            BOOT_PASS_HASH=$(echo "$BOOT_RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        fi
        if [ -z "$BOOT_PASS_HASH" ]; then
            echo "错误：无法生成 qBittorrent 内部凭证" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        unset BOOT_RANDOM_PASS

        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=127.0.0.1
WebUI\Port=${WEBUI_PORT}
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=${BOOT_PASS_HASH}
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
[Application]
FileLogger\Backup=false
EOF
        unset BOOT_PASS_HASH
    fi

    SAVE_PATH=$(grep -E "(Session\\\\DefaultSavePath|Downloads\\\\SavePath)=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2-)
    if [ -n "$SAVE_PATH" ]; then
        if [ ! -d "$SAVE_PATH" ]; then
            if echo "$SAVE_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
                mkdir -p "$SAVE_PATH" 2>/dev/null && echo "已创建下载目录：$SAVE_PATH" >> "$LOG_FILE" || echo "警告：无法创建下载目录（$SAVE_PATH），请前往【系统设置 - 应用 - qBittorrent】设置允许访问的文件夹" >> "$LOG_FILE"
            else
                echo "警告：下载目录（$SAVE_PATH）不存在，请在 fnOS 文件管理中创建" >> "$LOG_FILE"
            fi
        elif [ ! -r "$SAVE_PATH" ] || [ ! -w "$SAVE_PATH" ]; then
            echo "警告：下载目录（$SAVE_PATH）没有读写权限，请前往【系统设置 - 应用 - qBittorrent】设置允许访问的文件夹" >> "$LOG_FILE"
        fi
    fi

    TEMP_PATH=$(grep -E "^Session\\\\TempPath=" "$CONFIG_FILE" 2>/dev/null | head -1 | cut -d'=' -f2-)
    if [ -n "$TEMP_PATH" ] && [ ! -d "$TEMP_PATH" ]; then
        if echo "$TEMP_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
            mkdir -p "$TEMP_PATH" 2>/dev/null || true
        fi
    fi

    export QT_QPA_PLATFORM=offscreen

    # 启动前确认端口可用：配置文件里的端口可能已被其他应用/容器占用。
    # 顺延到可用端口并写回配置，代理随后会从配置里读到同一个端口，
    # 这样“端口被别人占了”就不会再变成“应用启动失败”。
    AVAILABLE_PORT=$(resolve_webui_port "$WEBUI_PORT" 2>/dev/null) || AVAILABLE_PORT=""
    if [ -z "$AVAILABLE_PORT" ]; then
        echo "错误：端口 ${WEBUI_PORT}-$((WEBUI_PORT + WEBUI_PORT_SCAN)) 均被占用，无法启动" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if [ "$AVAILABLE_PORT" != "$WEBUI_PORT" ]; then
        PORT_OWNER=$(ss -ltn 2>/dev/null | grep -E ":${WEBUI_PORT}[[:space:]]" | head -1 | tr -s ' ')
        echo "$(date '+%Y-%m-%d %H:%M:%S') - WebUI 端口 ${WEBUI_PORT} 已被占用，自动改用 ${AVAILABLE_PORT}${PORT_OWNER:+（占用项：${PORT_OWNER}）}" >> "$LOG_FILE"
        echo "WebUI 端口 ${WEBUI_PORT} 已被其他程序占用，已自动改用 ${AVAILABLE_PORT}"
        WEBUI_PORT="$AVAILABLE_PORT"
        set_config_port "$WEBUI_PORT"
    fi

    # 残留实例锁会让 qBittorrent 启动后立即静默退出（详见 clean_stale_lockfile）
    clean_stale_lockfile

    # 记录启动前的日志长度，失败时只分析本次新增的日志
    LOG_OFFSET=$(stat -c%s "$LOG_FILE" 2>/dev/null || stat -f%z "$LOG_FILE" 2>/dev/null || echo 0)

    echo "Starting qBittorrent..."
    "$BIN_DIR/qbittorrent-nox" \
        --confirm-legal-notice \
        --profile="${DATA_DIR}" \
        --webui-port="$WEBUI_PORT" \
        >> "$LOG_FILE" 2>&1 &

    PID=$!
    echo $PID > "$PID_FILE"

    # 尽早启动代理，与 qBittorrent 并行初始化
    # 代理会等待 qBittorrent WebUI 就绪后才接受请求
    # 直接同步调用，避免子 shell 使 gateway-proxy.py 脱离管理、残留孤儿进程
    start_proxy

    # 短等待后检测进程是否存活（最长 3s，按 0.1s 间隔检测）
    elapsed=0
    while [ $elapsed -lt 30 ]; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        # 存活超过 2s 即可认为启动成功：qBittorrent 因残留锁/配置异常退出
        # 大约发生在启动后 1s 左右，窗口太短会把“秒退”误判成启动成功
        if [ $elapsed -ge 20 ]; then
            break
        fi
        sleep 0.1
        elapsed=$((elapsed + 1))
    done

    if ! ps -p "$PID" > /dev/null 2>&1; then
        # 只看本次启动新写入的日志，避免历史记录里的旧报错误判为本次失败原因
        NEW_LOG=""
        if [ -f "$LOG_FILE" ]; then
            NEW_LOG=$(tail -c "+$((LOG_OFFSET + 1))" "$LOG_FILE" 2>/dev/null)
        fi
        # 只有端口确实不可绑定时才归因为“端口被占用”。
        # 日志里别处的 bind 失败（例如 MCP 自己的 8082）不能算到 WebUI 端口头上，
        # 历史上正是这种全局 grep 把“残留实例锁导致秒退”误报成“8080 被占用”。
        if ! port_available "$WEBUI_ADDRESS" "$WEBUI_PORT"; then
            echo "错误：端口 ${WEBUI_PORT} 被其他程序占用" > "$TRIM_TEMP_LOGFILE"
            ss -ltn 2>/dev/null | grep -E ":${WEBUI_PORT}[[:space:]]" | tr -s ' ' >> "$TRIM_TEMP_LOGFILE"
        elif printf '%s\n' "$NEW_LOG" | grep -qi "lockfile\|another instance\|already running"; then
            echo "错误：${APP_NAME} 启动失败：实例锁（${LOCK_FILE}）异常，清理后仍无法启动" > "$TRIM_TEMP_LOGFILE"
        else
            echo "错误：${APP_NAME} 启动失败" > "$TRIM_TEMP_LOGFILE"
        fi
        printf '%s\n' "$NEW_LOG" | tail -20 >> "$TRIM_TEMP_LOGFILE"
        rm -f "$PID_FILE"
        exit 1
    fi

    echo "${APP_NAME} started (PID: $PID)"

    exit 0
    ;;

stop)
    stop_proxy
    stop_mcp

    PID=""
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
    fi
    if [ -z "$PID" ] || ! ps -p "$PID" > /dev/null 2>&1; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
    fi

    if [ -z "$PID" ]; then
        echo "${APP_NAME} is not running"
        # 未在运行时，stop 视为成功（幂等），返回 0
        exit 0
    fi

    echo "Stopping ${APP_NAME} (PID: $PID)..."
    kill "$PID" 2>/dev/null || true

    TIMEOUT=10
    while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
        sleep 0.5
        TIMEOUT=$((TIMEOUT - 1))
    done

    if ps -p "$PID" > /dev/null 2>&1; then
        kill -9 "$PID" 2>/dev/null || true
        sleep 1
    fi

    # 停止后必须确认进程真的没了，否则升级流程会带着运行中的进程继续，
    # 导致配置文件被改写时 qBittorrent 覆盖回旧值。
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "错误：无法停止 ${APP_NAME}（PID: $PID 仍然存活）" > "$TRIM_TEMP_LOGFILE"
        echo "错误：无法停止 ${APP_NAME}（PID: $PID 仍然存活）"
        exit 1
    fi

    rm -f "$PID_FILE"
    echo "${APP_NAME} stopped"
    exit 0
    ;;

restart)
    "$SCRIPT_DIR/main" stop
    sleep 2
    "$SCRIPT_DIR/main" start
    ;;

status)
    RUNNING=false
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            RUNNING=true
        fi
    fi
    if [ "$RUNNING" = false ]; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile.*${DATA_DIR}" 2>/dev/null | head -1)
        if [ -n "$PID" ]; then
            RUNNING=true
        fi
    fi

    if [ "$RUNNING" = true ]; then
        echo "${APP_NAME} is running (PID: $PID)"
        exit 0
    else
        echo "${APP_NAME} is not running"
        exit 3
    fi
    ;;

*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
