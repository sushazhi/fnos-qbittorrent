#!/bin/bash
# cmd/main - qBittorrent应用生命周期管理脚本

APP_NAME="qbittorrent"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
LOG_FILE="${TRIM_PKGVAR}/${APP_NAME}.log"

# 端口配置
WEBUI_PORT="${wizard_app_port:-${TRIM_SERVICE_PORT:-8080}}"

case "$1" in
start)
    # 检查是否已运行
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            echo "${APP_NAME} is already running (PID: $PID)"
            exit 0
        fi
        rm -f "$PID_FILE"
    fi

    # 创建必要的目录
    mkdir -p "$(dirname "$PID_FILE")" "${DATA_DIR}/qBittorrent/config"

    # 设置环境变量
    export QT_QPA_PLATFORM=offscreen

    # 检查可执行文件
    if [ ! -f "$BIN_DIR/qbittorrent-nox" ]; then
        echo "错误：未找到可执行文件 qbittorrent-nox" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi
    if [ ! -x "$BIN_DIR/qbittorrent-nox" ]; then
        chmod +x "$BIN_DIR/qbittorrent-nox"
    fi

    # 只在配置文件不存在时创建默认配置
    if [ ! -f "$CONFIG_FILE" ]; then
        cat > "$CONFIG_FILE" << EOF
[Preferences]
General\Locale=zh_CN
Downloads\SavePath=/vol1/1000/downloads/
Downloads\TempPath=/vol1/1000/temp/
WebUI\Address=*
WebUI\Port=${WEBUI_PORT}
WebUI\LocalHostAuth=true
WebUI\Username=admin
WebUI\Password_PBKDF2=@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
EOF
    fi

    # 启动qBittorrent-nox
    echo "Starting qBittorrent..."
    "$BIN_DIR/qbittorrent-nox" \
        --profile="${DATA_DIR}" \
        --webui-port="$WEBUI_PORT" \
        >> "$LOG_FILE" 2>&1 &

    PID=$!
    echo $PID > "$PID_FILE"

    sleep 3
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "${APP_NAME} started (PID: $PID)"
        exit 0
    else
        # 检查是否是端口占用问题
        if [ -f "$LOG_FILE" ]; then
            if grep -qi "port.*already\|bind.*failed\|address.*in.*use" "$LOG_FILE" 2>/dev/null; then
                echo "错误：端口 ${WEBUI_PORT} 被其他程序占用，请更换端口后重试" > "$TRIM_TEMP_LOGFILE"
                rm -f "$PID_FILE"
                exit 1
            fi
        fi
        echo "错误：${APP_NAME} 启动失败" > "$TRIM_TEMP_LOGFILE"
        if [ -f "$LOG_FILE" ]; then
            tail -20 "$LOG_FILE" >> "$TRIM_TEMP_LOGFILE"
        fi
        rm -f "$PID_FILE"
        exit 1
    fi
    ;;

stop)
    # 查找进程
    PID=""
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE" 2>/dev/null)
    fi
    if [ -z "$PID" ] || ! ps -p "$PID" > /dev/null 2>&1; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile" 2>/dev/null | head -1)
    fi

    if [ -z "$PID" ]; then
        echo "${APP_NAME} is not running"
        exit 0
    fi

    echo "Stopping ${APP_NAME} (PID: $PID)..."
    kill "$PID" 2>/dev/null || true

    TIMEOUT=10
    while ps -p "$PID" > /dev/null 2>&1 && [ $TIMEOUT -gt 0 ]; do
        sleep 0.5
        TIMEOUT=$((TIMEOUT - 1))
    done

    if ps -p "$PID" > /dev/null 2>&1; then
        kill -9 "$PID" 2>/dev/null || true
    fi

    rm -f "${TRIM_PKGTMP}/${APP_NAME}.pid" 2>/dev/null
    echo "${APP_NAME} stopped"
    exit 0
    ;;

restart)
    "$0" stop
    sleep 2
    "$0" start
    ;;

status)
    RUNNING=false
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            RUNNING=true
        fi
    fi
    if [ "$RUNNING" = false ]; then
        PID=$(pgrep -f "qbittorrent-nox.*--profile" 2>/dev/null | head -1)
        if [ -n "$PID" ]; then
            RUNNING=true
        fi
    fi

    if [ "$RUNNING" = true ]; then
        echo "${APP_NAME} is running (PID: $PID)"
        exit 0
    else
        echo "${APP_NAME} is not running"
        exit 3
    fi
    ;;

*)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
