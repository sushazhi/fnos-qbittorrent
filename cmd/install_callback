#!/bin/bash
# cmd/install_callback - qBittorrent安装后置脚本

APP_NAME="qbittorrent"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/qBittorrent/config"
CONFIG_FILE="${CONFIG_DIR}/qBittorrent.conf"

echo "Running ${APP_NAME} install_callback..."

# 清理历史版本（<=5.3.0.0）遗留的生命周期锁文件。
# 旧版本把升级锁放在 TRIM_PKGTMP，一旦升级中断，锁文件会残留，
# 导致此后每次升级都报"另一个升级进程正在运行"且无法自愈。
# 安装/覆盖安装是唯一必经入口，在这里清一次可让已卡住的用户自动恢复。
for _stale_lock in \
    "${TRIM_PKGTMP:-/nonexistent}/${APP_NAME}.upgrade.lock" \
    "${TRIM_PKGTMP:-/nonexistent}/${APP_NAME}.lock" \
    "/tmp/${APP_NAME}.upgrade.lock" \
    "/tmp/${APP_NAME}.lock" \
    "/var/tmp/${APP_NAME}.upgrade.lock" \
    "/var/tmp/${APP_NAME}.lock"
do
    if [ -f "$_stale_lock" ]; then
        # 只在确认无人持有该锁时才删除，避免打断真正在跑的升级。
        # 探测放在子 shell：能拿到锁(rc=0) 才算残留；flock 不可用(rc=2) 时保守跳过。
        (
            exec 212>>"$_stale_lock" 2>/dev/null || exit 2
            flock -n 212 2>/dev/null || exit 1
            exit 0
        )
        if [ $? -eq 0 ]; then
            rm -f "$_stale_lock" 2>/dev/null && echo "已清理残留生命周期锁: $_stale_lock"
        else
            echo "跳过仍被占用或无法探测的锁: $_stale_lock"
        fi
    fi
done
unset _stale_lock

# 设置可执行权限
if ! chmod +x "$BIN_DIR/qbittorrent-nox" 2>/dev/null; then
    echo "Warning: Failed to set executable permission on qbittorrent-nox" > "$TRIM_TEMP_LOGFILE"
fi
if [ -f "$BIN_DIR/qbt_password.py" ]; then
    chmod +x "$BIN_DIR/qbt_password.py" 2>/dev/null || true
fi

# 生成密码哈希（优先用户提供的密码；否则自动生成强随机内部凭证，避免使用公开默认密码）
# 通过 stdin 传入密码（避免在 ps 中暴露命令行参数）
PASSWORD_HASH=""
if [ -n "${wizard_password:-}" ]; then
    echo "Generating password hash from user-provided password..."
    PASSWORD_HASH=$(echo "${wizard_password}" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
    if [ -z "$PASSWORD_HASH" ]; then
        echo "警告：密码哈希生成失败，将使用随机生成密码" > "$TRIM_TEMP_LOGFILE"
    else
        echo "Password hash generated successfully"
    fi
fi

# 统一网关模式：无用户密码时自动生成随机强密码（SSO 免密，随机凭证仅作安全兜底）
if [ -z "$PASSWORD_HASH" ]; then
    RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
    if [ -z "$RANDOM_PASS" ]; then
        RANDOM_PASS="${TRIM_API_TOKEN:-}${RANDOM}${RANDOM}${RANDOM}"
        RANDOM_PASS=$(echo "$RANDOM_PASS" | tr -dc 'a-zA-Z0-9' | head -c 24)
    fi
    if [ -n "$RANDOM_PASS" ]; then
        PASSWORD_HASH=$(echo "$RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        echo "Generated random internal credential (SSO mode)"
    fi
    unset RANDOM_PASS
fi

# 获取UI类型选择（默认vuetorrent）
UI_TYPE="${wizard_ui_type:-vuetorrent}"

# 获取下载目录配置
SAVE_PATH="${wizard_save_path:-/vol1/@appshare/qbittorrent/downloads/}"
if [ ! -d "$SAVE_PATH" ]; then
    echo "Warning: save path not exists, fallback to /vol1/@appshare/qbittorrent/downloads/"
    SAVE_PATH="/vol1/@appshare/qbittorrent/downloads/"
fi

echo "Configuring UI type: $UI_TYPE"
echo "Save Path: $SAVE_PATH"

# 创建配置目录
mkdir -p "$CONFIG_DIR"

# 确保下载目录存在
mkdir -p "$SAVE_PATH" 2>/dev/null || true

# 根据UI类型设置配置
case "$UI_TYPE" in
    vuetorrent)
        ALT_UI_ENABLED="true"
        ;;
    native)
        ALT_UI_ENABLED="false"
        ;;
    *)
        echo "Unknown UI type: $UI_TYPE, using default vuetorrent"
        ALT_UI_ENABLED="true"
        UI_TYPE="vuetorrent"
        ;;
esac

# 检查配置文件是否已存在（用户卸载时可能保留了配置）
if [ -f "$CONFIG_FILE" ]; then
    echo "Configuration file exists, updating settings while preserving other settings..."

    # 读取用户当前端口：只在配置里没有端口时才用默认 8080。
    # 历史上这里无条件写死 8080，导致用户自定义端口在覆盖安装时被静默重置。
    # 注意：qBittorrent 自己把端口写在 [WebUI] 段内的 Port=，
    # 只认 WebUI\Port= 会漏掉用户在 WebUI 里改过的端口。
    CUR_PORT=$(awk '
        /^\[/ { in_webui = ($0 == "[WebUI]"); next }
        in_webui && /^[ \t]*Port=/ { sub(/^[ \t]*Port=/, ""); v = $0; exit }
        /^[ \t]*WebUI\\Port=/ { sub(/^[ \t]*WebUI\\Port=/, ""); v = $0 }
        END { if (v != "") print v }
    ' "$CONFIG_FILE" 2>/dev/null | tr -d ' \r\n')
    case "$CUR_PORT" in
        ''|*[!0-9]*) CUR_PORT=8080 ;;
    esac
    [ "$CUR_PORT" -gt 0 ] 2>/dev/null || CUR_PORT=8080
    echo "Preserving WebUI port: $CUR_PORT"

    TMP_CONFIG=$(mktemp)
    awk -v alt_ui="${ALT_UI_ENABLED}" -v save_path="${SAVE_PATH}" -v new_pass="${PASSWORD_HASH}" \
        -v root="${TRIM_APPDEST}/ui/vuetorrent" -v cur_port="${CUR_PORT}" '
        function starts_with(s, p) { return index(s, p) == 1 }
        {
            if ($0 == "[BitTorrent]") {
                print $0
                print "Session\\DefaultSavePath=" save_path
                in_bt = 1
                save_written = 1
                next
            }
            # [BitTorrent] 段内旧的 DefaultSavePath 已被新值取代，跳过旧行避免重复
            if (in_bt && starts_with($0, "Session\\DefaultSavePath=")) { next }
            if ($0 == "[Preferences]") {
                print $0
                in_pref = 1
                pref_seen = 1
                in_webui = 0
                next
            }
            # [WebUI] 是 qBittorrent 原生写法的段：段内键是不带前缀的裸键
            if ($0 == "[WebUI]") {
                print $0
                in_webui = 1
                webui_seen = 1
                in_pref = 0
                next
            }
            # 任何新 section 开始时，先补齐 [BitTorrent] 缺失的保存路径
            if ($0 ~ /^\[/ && in_bt && !save_written) {
                print "Session\\DefaultSavePath=" save_path
                save_written = 1
            }
            if ($0 ~ /^\[/) { in_bt = 0; in_pref = 0; in_webui = 0 }

            # ---- [WebUI] 段内的规范键 ----
            if (in_webui) {
                if (starts_with($0, "WebUI\\")) {
                    # 段内的 WebUI\xxx 会被解析成 WebUI\WebUI\xxx，是死键，丢弃
                    next
                }
                if (starts_with($0, "Port=")) {
                    print "Port=" cur_port
                    port_done = 1
                    next
                }
                if (starts_with($0, "Address=")) { print $0; addr_done = 1; next }
                if (starts_with($0, "LocalHostAuth=")) { print $0; lha_done = 1; next }
                if (starts_with($0, "AlternativeUIEnabled=")) {
                    print "AlternativeUIEnabled=" alt_ui
                    alt_done = 1
                    next
                }
                if (starts_with($0, "RootFolder=")) {
                    if (alt_ui == "true") print "RootFolder=" root
                    else print $0
                    root_done = 1
                    next
                }
                if (starts_with($0, "Password_PBKDF2=")) {
                    if (new_pass != "") print "Password_PBKDF2=" new_pass
                    else print $0
                    pass_done = 1
                    next
                }
            }

            # ---- [Preferences] 内的历史遗留键（旧版本写法）：逐项处理，保留用户值 ----
            if (starts_with($0, "WebUI\\Port=")) {
                # 保留用户端口；从未设置过则补默认值
                print "WebUI\\Port=" cur_port
                port_done = 1
                next
            }
            if (starts_with($0, "WebUI\\Address=")) { print $0; addr_done = 1; next }
            if (starts_with($0, "WebUI\\LocalHostAuth=")) { print $0; lha_done = 1; next }
            if (starts_with($0, "WebUI\\AlternativeUIEnabled=")) {
                print "WebUI\\AlternativeUIEnabled=" alt_ui
                alt_done = 1
                next
            }
            if (starts_with($0, "WebUI\\RootFolder=")) {
                # 仅在启用 VueTorrent 时接管 RootFolder，否则保留用户值
                if (alt_ui == "true") print "WebUI\\RootFolder=" root
                else print $0
                root_done = 1
                next
            }
            if (starts_with($0, "WebUI\\Password_PBKDF2=")) {
                if (new_pass != "") print "WebUI\\Password_PBKDF2=" new_pass
                else print $0
                pass_done = 1
                next
            }
            # 其余所有键（含 Downloads\\SavePath、限速、高级设置）原样保留
            print $0
        }
        END {
            # 缺键时必须补在正确的段里：qBittorrent 原生读写 [WebUI] 段的裸键，
            # 把 WebUI\xxx 直接追加到文件末尾会落进最后一个 section，
            # 变成 WebUI\WebUI\xxx 这样的死键（历史事故：端口/UI 开关静默失效）。
            if (!port_done || !addr_done || !lha_done || !alt_done || (alt_ui == "true" && !root_done)) {
                print "[WebUI]"
                if (!port_done) print "Port=" cur_port
                if (!addr_done) print "Address=0.0.0.0"
                if (!lha_done) print "LocalHostAuth=false"
                if (!alt_done) print "AlternativeUIEnabled=" alt_ui
                if (alt_ui == "true" && !root_done) print "RootFolder=" root
            }
            if (!save_written) {
                print "[BitTorrent]"
                print "Session\\DefaultSavePath=" save_path
            }
        }
    ' "$CONFIG_FILE" > "$TMP_CONFIG"

    if [ -s "$TMP_CONFIG" ]; then
        mv "$TMP_CONFIG" "$CONFIG_FILE"
        echo "Configuration updated (savepath, UI, gateway mode), user settings preserved"
    else
        rm -f "$TMP_CONFIG"
        echo "警告：配置合并结果为空，保留原配置未改动" > "$TRIM_TEMP_LOGFILE"
        echo "警告：配置合并失败，已跳过（原配置保持不变）"
    fi
else
    echo "Creating new configuration file..."

    # 尝试从残留配置中保留凭证（卸载后重装场景）
    OLD_USER=""
    OLD_PASS=""
    SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
    if [ -z "$SHARE_DIR" ]; then
        SHARE_DIR="/vol1/@appshare/qbittorrent"
    fi
    # 从残留配置里读单个 WebUI 键：同时认 [WebUI] 段内的裸键（qBittorrent 原生写法）
    # 和历史的 WebUI\xxx 写法。只认后者会漏掉真实凭证，重装后用户密码被随机值顶掉。
    _read_webui_key() {
        awk -v k="$2" '
            function strip(line, prefix) { return substr(line, length(prefix) + 1) }
            {
                if ($0 ~ /^\[/) { in_webui = ($0 == "[WebUI]"); next }
                if (in_webui) { p = k "="; if (index($0, p) == 1) { v = strip($0, p); exit } }
                p2 = "WebUI\\" k "=";
                if (index($0, p2) == 1) { v = strip($0, p2) }
            }
            END { if (v != "") print v }
        ' "$1" 2>/dev/null
    }
    for old_conf in "${DATA_DIR}/qBittorrent/config/qBittorrent.conf" \
                     "${SHARE_DIR}/.data_backup/qBittorrent/config/qBittorrent.conf"; do
        if [ -f "$old_conf" ]; then
            OLD_USER=$(_read_webui_key "$old_conf" "Username")
            OLD_PASS=$(_read_webui_key "$old_conf" "Password_PBKDF2")
            if [ -n "$OLD_USER" ] && [ -n "$OLD_PASS" ]; then
                echo "保留已有凭证（用户名: $OLD_USER）"
                break
            fi
            OLD_USER=""
            OLD_PASS=""
        fi
    done

    # SSO 模式：PASSWORD_HASH 已由用户密码或随机内部凭证填充（见上方逻辑）
    if [ -n "$PASSWORD_HASH" ]; then
        OLD_USER="${wizard_username:-admin}"
        OLD_PASS="$PASSWORD_HASH"
        echo "使用 qBittorrent 内部凭证（SSO 网关免密）"
    elif [ -z "$OLD_USER" ]; then
        # 极端兜底：仍未获得密码哈希时，重新生成随机凭证，绝不使用公开默认密码
        RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        OLD_USER="admin"
        OLD_PASS=$(echo "$RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        if [ -z "$OLD_PASS" ]; then
            echo "错误：无法生成 qBittorrent 内部凭证" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        echo "使用随机生成的内部凭证（SSO 网关免密）"
    fi

    # 根据UI类型创建完整默认配置
    case "$UI_TYPE" in
        vuetorrent)
            cat > "$CONFIG_FILE" << CFGEOF
[BitTorrent]
Session\DefaultSavePath=${SAVE_PATH}
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=${OLD_USER}
WebUI\Password_PBKDF2=${OLD_PASS}
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
[Application]
FileLogger\Backup=false
CFGEOF
            echo "VueTorrent configured (gateway mode)"
            ;;
        native)
            cat > "$CONFIG_FILE" << CFGEOF
[BitTorrent]
Session\DefaultSavePath=${SAVE_PATH}
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=${OLD_USER}
WebUI\Password_PBKDF2=${OLD_PASS}
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=false
[Application]
FileLogger\Backup=false
CFGEOF
            echo "Native UI configured (gateway mode)"
            ;;
        *)
            echo "Unknown UI type: $UI_TYPE"
            ;;
    esac
fi

echo "=================================="
echo "qBittorrent installation complete"
echo "=================================="
echo ""
echo "UI Type: $UI_TYPE"
if [ "$UI_TYPE" = "native" ]; then
    echo "Mode: Direct access (new tab)"
    echo "Access: http://<NAS_IP>:5666/app/qbittorrent/"
else
    echo "Mode: Gateway (iframe)"
    echo "Access: /app/qbittorrent"
fi
echo "Save Path: $SAVE_PATH"
echo ""
echo "Start the application to use qBittorrent"
exit 0
