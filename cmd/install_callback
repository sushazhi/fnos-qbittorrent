#!/bin/bash
# cmd/install_callback - qBittorrent安装后置脚本

APP_NAME="qbittorrent"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/qBittorrent/config"
CONFIG_FILE="${CONFIG_DIR}/qBittorrent.conf"

echo "Running ${APP_NAME} install_callback..."

# 设置可执行权限
if ! chmod +x "$BIN_DIR/qbittorrent-nox" 2>/dev/null; then
    echo "Warning: Failed to set executable permission on qbittorrent-nox" > "$TRIM_TEMP_LOGFILE"
fi
if [ -f "$BIN_DIR/qbt_password.py" ]; then
    chmod +x "$BIN_DIR/qbt_password.py" 2>/dev/null || true
fi

# 生成密码哈希（优先用户提供的密码；否则自动生成强随机内部凭证，避免使用公开默认密码）
# 通过 stdin 传入密码（避免在 ps 中暴露命令行参数）
PASSWORD_HASH=""
if [ -n "${wizard_password:-}" ]; then
    echo "Generating password hash from user-provided password..."
    PASSWORD_HASH=$(echo "${wizard_password}" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
    if [ -z "$PASSWORD_HASH" ]; then
        echo "警告：密码哈希生成失败，将使用随机生成密码" > "$TRIM_TEMP_LOGFILE"
    else
        echo "Password hash generated successfully"
    fi
fi

# 统一网关模式：无用户密码时自动生成随机强密码（SSO 免密，随机凭证仅作安全兜底）
if [ -z "$PASSWORD_HASH" ]; then
    RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
    if [ -z "$RANDOM_PASS" ]; then
        RANDOM_PASS="${TRIM_API_TOKEN:-}${RANDOM}${RANDOM}${RANDOM}"
        RANDOM_PASS=$(echo "$RANDOM_PASS" | tr -dc 'a-zA-Z0-9' | head -c 24)
    fi
    if [ -n "$RANDOM_PASS" ]; then
        PASSWORD_HASH=$(echo "$RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        echo "Generated random internal credential (SSO mode)"
    fi
    unset RANDOM_PASS
fi

# 获取UI类型选择（默认vuetorrent）
UI_TYPE="${wizard_ui_type:-vuetorrent}"

# 获取下载目录配置
SAVE_PATH="${wizard_save_path:-/vol1/@appshare/qbittorrent/downloads/}"
if [ ! -d "$SAVE_PATH" ]; then
    echo "Warning: save path not exists, fallback to /vol1/@appshare/qbittorrent/downloads/"
    SAVE_PATH="/vol1/@appshare/qbittorrent/downloads/"
fi

echo "Configuring UI type: $UI_TYPE"
echo "Save Path: $SAVE_PATH"

# 创建配置目录
mkdir -p "$CONFIG_DIR"

# 确保下载目录存在
mkdir -p "$SAVE_PATH" 2>/dev/null || true

# 根据UI类型设置配置
case "$UI_TYPE" in
    vuetorrent)
        ALT_UI_ENABLED="true"
        ;;
    native)
        ALT_UI_ENABLED="false"
        ;;
    *)
        echo "Unknown UI type: $UI_TYPE, using default vuetorrent"
        ALT_UI_ENABLED="true"
        UI_TYPE="vuetorrent"
        ;;
esac

# 检查配置文件是否已存在（用户卸载时可能保留了配置）
if [ -f "$CONFIG_FILE" ]; then
    echo "Configuration file exists, updating settings while preserving other settings..."

    TMP_CONFIG=$(mktemp)
    awk -v alt_ui="${ALT_UI_ENABLED}" -v save_path="${SAVE_PATH}" -v new_pass="${PASSWORD_HASH}" '
        BEGIN { alt_ui_updated = 0; save_updated = 0; bittorrent_section = 0; port_updated = 0; addr_updated = 0; lha_updated = 0; pass_updated = 0; }
        {
            if ($0 == "[BitTorrent]") {
                print $0
                print "Session\\DefaultSavePath=" save_path
                bittorrent_section = 1
                save_updated = 1
            }
            else if ($0 == "[Preferences]") {
                print $0
                if (!port_updated) { print "WebUI\\Port=8080"; port_updated = 1; }
                if (!addr_updated) { print "WebUI\\Address=0.0.0.0"; addr_updated = 1; }
                if (!lha_updated) { print "WebUI\\LocalHostAuth=false"; lha_updated = 1; }
                if (new_pass != "" && !pass_updated) {
                    print "WebUI\\Password_PBKDF2=" new_pass;
                    pass_updated = 1;
                }
                print "WebUI\\AlternativeUIEnabled=" alt_ui
                alt_ui_updated = 1
            }
            else if (new_pass != "" && $0 ~ /^WebUI\\Password_PBKDF2=/) {
                if (!pass_updated) {
                    print "WebUI\\Password_PBKDF2=" new_pass;
                    pass_updated = 1;
                }
                next
            }
            else if (!/^WebUI\\Port=/ && !/^WebUI\\Address=/ && !/^WebUI\\AlternativeUIEnabled=/ && !/^WebUI\\LocalHostAuth=/ && !/^WebUI\\Password_PBKDF2=/ && !/^Downloads\\SavePath=/ && !/^Session\\DefaultSavePath=/) {
                print $0
            }
        }
        END {
            if (!port_updated && !alt_ui_updated && !save_updated) {
                print "[BitTorrent]"
                print "Session\\DefaultSavePath=" save_path
                print "[Preferences]"
                print "WebUI\\Port=8080"
                print "WebUI\\Address=0.0.0.0"
                print "WebUI\\LocalHostAuth=false"
                if (new_pass != "") print "WebUI\\Password_PBKDF2=" new_pass
                print "WebUI\\AlternativeUIEnabled=" alt_ui
            }
        }
    ' "$CONFIG_FILE" > "$TMP_CONFIG"

    mv "$TMP_CONFIG" "$CONFIG_FILE"
    echo "Configuration updated (savepath, UI, gateway mode)"
else
    echo "Creating new configuration file..."

    # 尝试从残留配置中保留凭证（卸载后重装场景）
    OLD_USER=""
    OLD_PASS=""
    SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
    if [ -z "$SHARE_DIR" ]; then
        SHARE_DIR="/vol1/@appshare/qbittorrent"
    fi
    for old_conf in "${DATA_DIR}/qBittorrent/config/qBittorrent.conf" \
                     "${SHARE_DIR}/.data_backup/qBittorrent/config/qBittorrent.conf"; do
        if [ -f "$old_conf" ]; then
            OLD_USER=$(grep "^WebUI\\\\Username=" "$old_conf" 2>/dev/null | head -1 | sed 's/WebUI\\Username=//')
            OLD_PASS=$(grep "^WebUI\\\\Password_PBKDF2=" "$old_conf" 2>/dev/null | head -1 | sed 's/WebUI\\Password_PBKDF2=//')
            if [ -n "$OLD_USER" ] && [ -n "$OLD_PASS" ]; then
                echo "保留已有凭证（用户名: $OLD_USER）"
                break
            fi
            OLD_USER=""
            OLD_PASS=""
        fi
    done

    # SSO 模式：PASSWORD_HASH 已由用户密码或随机内部凭证填充（见上方逻辑）
    if [ -n "$PASSWORD_HASH" ]; then
        OLD_USER="${wizard_username:-admin}"
        OLD_PASS="$PASSWORD_HASH"
        echo "使用 qBittorrent 内部凭证（SSO 网关免密）"
    elif [ -z "$OLD_USER" ]; then
        # 极端兜底：仍未获得密码哈希时，重新生成随机凭证，绝不使用公开默认密码
        RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        OLD_USER="admin"
        OLD_PASS=$(echo "$RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        if [ -z "$OLD_PASS" ]; then
            echo "错误：无法生成 qBittorrent 内部凭证" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        echo "使用随机生成的内部凭证（SSO 网关免密）"
    fi

    # 根据UI类型创建完整默认配置
    case "$UI_TYPE" in
        vuetorrent)
            cat > "$CONFIG_FILE" << CFGEOF
[BitTorrent]
Session\DefaultSavePath=${SAVE_PATH}
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=${OLD_USER}
WebUI\Password_PBKDF2=${OLD_PASS}
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
[Application]
FileLogger\Backup=false
CFGEOF
            echo "VueTorrent configured (gateway mode)"
            ;;
        native)
            cat > "$CONFIG_FILE" << CFGEOF
[BitTorrent]
Session\DefaultSavePath=${SAVE_PATH}
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=${OLD_USER}
WebUI\Password_PBKDF2=${OLD_PASS}
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=false
[Application]
FileLogger\Backup=false
CFGEOF
            echo "Native UI configured (gateway mode)"
            ;;
        *)
            echo "Unknown UI type: $UI_TYPE"
            ;;
    esac
fi

echo "=================================="
echo "qBittorrent installation complete"
echo "=================================="
echo ""
echo "UI Type: $UI_TYPE"
if [ "$UI_TYPE" = "native" ]; then
    echo "Mode: Direct access (new tab)"
    echo "Access: http://<NAS_IP>:5666/app/qbittorrent/"
else
    echo "Mode: Gateway (iframe)"
    echo "Access: /app/qbittorrent"
fi
echo "Save Path: $SAVE_PATH"
echo ""
echo "Start the application to use qBittorrent"
exit 0
