#!/bin/bash
# cmd/config_callback - qBittorrent配置回调脚本
# 功能：应用配置变更，更新端口设置并重启服务

set -e

APP_NAME="qbittorrent"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
MAIN_SCRIPT="/var/apps/qbittorrent/cmd/main"

echo "正在应用 qBittorrent 配置..."

# 获取新的端口配置（从向导传递）
NEW_PORT="${wizard_app_port:-8080}"
echo "配置端口: $NEW_PORT"

# 如果应用正在运行，先停止
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
        echo "停止当前运行的服务..."
        "$MAIN_SCRIPT" stop
        sleep 2
    fi
fi

# 更新配置文件中的端口
if [ -f "$CONFIG_FILE" ]; then
    echo "更新配置文件端口..."
    if grep -q "^WebUI\\\\Port=" "$CONFIG_FILE"; then
        sed -i "s/^WebUI\\\\Port=.*/WebUI\\\\Port=${NEW_PORT}/" "$CONFIG_FILE"
    else
        echo "WebUI\\\\Port=${NEW_PORT}" >> "$CONFIG_FILE"
    fi
    echo "配置文件已更新"
else
    echo "警告：配置文件不存在，将在首次启动时创建"
fi

# 重新启动应用
echo "正在重启应用..."
"$MAIN_SCRIPT" start

echo "qBittorrent 配置已应用，服务已重启"
exit 0
