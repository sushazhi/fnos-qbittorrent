#!/bin/bash
# cmd/config_callback - qBittorrent配置回调脚本

set -u

APP_NAME="qbittorrent"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_FILE="${DATA_DIR}/qBittorrent/config/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
LOCK_FILE="${TRIM_PKGTMP}/${APP_NAME}.lock"
MAIN_SCRIPT="/var/apps/qbittorrent/cmd/main"
UI_CONFIG="${TRIM_APPDEST}/ui/config"

echo "正在应用 qBittorrent 配置..."

UI_TYPE="${wizard_ui_type:-vuetorrent}"
echo "界面类型: $UI_TYPE"

case "$UI_TYPE" in
    vuetorrent)
        ALT_UI_ENABLED="true"
        ;;
    native)
        ALT_UI_ENABLED="false"
        ;;
    *)
        echo "警告：未知的UI类型 $UI_TYPE，使用默认值 vuetorrent"
        ALT_UI_ENABLED="true"
        ;;
esac
WEBUI_ADDRESS="127.0.0.1"
LOCALHOST_AUTH="false"

# 管理员用户名
WIZARD_USERNAME="${wizard_username:-}"
if [ -n "$WIZARD_USERNAME" ]; then
    echo "管理员用户名: $WIZARD_USERNAME"
fi

# 管理员密码
WIZARD_PASSWORD="${wizard_password:-}"
WIZARD_PASS_HASH=""
if [ -n "$WIZARD_PASSWORD" ]; then
    echo "管理员密码: (已设置)"
    # 安全生成密码哈希：通过 stdin 传入密码，避免命令注入和 ps 泄露
    if command -v python3 >/dev/null 2>&1 && [ -f "${TRIM_APPDEST}/bin/qbt_password.py" ]; then
        WIZARD_PASS_HASH=$(echo "${WIZARD_PASSWORD}" | python3 "${TRIM_APPDEST}/bin/qbt_password.py" 2>/dev/null || echo "")
    fi
fi

WAS_RUNNING=false
if [ -f "$PID_FILE" ]; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && ps -p "$PID" > /dev/null 2>&1; then
        WAS_RUNNING=true
        echo "应用正在运行，需要先停止..."
        "$MAIN_SCRIPT" stop
        sleep 2
    else
        echo "应用当前处于停止状态"
    fi
else
    echo "应用当前处于停止状态"
fi

if [ -f "$CONFIG_FILE" ]; then
    echo "更新qBittorrent配置文件..."

    exec 200>"$LOCK_FILE"
    flock -w 10 200 || {
        echo "错误：无法获取配置文件锁" >&2
        exit 1
    }

    TMP_CONFIG=$(mktemp)
    awk -v alt_ui="${ALT_UI_ENABLED}" -v addr="${WEBUI_ADDRESS}" -v lha="${LOCALHOST_AUTH}" -v wizard_user="${WIZARD_USERNAME}" -v wizard_pass="${WIZARD_PASS_HASH}" '
        BEGIN {
            in_preferences = 0;
            alt_written = 0;
            addr_written = 0;
            lha_written = 0;
            user_written = 0;
            pass_written = 0;
        }
        {
            if ($0 ~ /^\[/) {
                # 离开 section 时补写未出现的字段
                if (in_preferences) {
                    if (!alt_written) print "WebUI\\AlternativeUIEnabled=" alt_ui
                    if (!addr_written) print "WebUI\\Address=" addr
                    if (!lha_written) print "WebUI\\LocalHostAuth=" lha
                    if (wizard_user != "" && !user_written) print "WebUI\\Username=" wizard_user
                    if (wizard_pass != "" && !pass_written) print "WebUI\\Password_PBKDF2=" wizard_pass
                }
                # 进入新 section
                in_preferences = ($0 == "[Preferences]")
                print $0
                next
            }

            # [Preferences] 字段
            if (in_preferences && $0 ~ /^WebUI\\AlternativeUIEnabled=/) {
                if (!alt_written) { print "WebUI\\AlternativeUIEnabled=" alt_ui; alt_written = 1; }
                next
            }
            if (in_preferences && $0 ~ /^WebUI\\Address=/) {
                if (!addr_written) { print "WebUI\\Address=" addr; addr_written = 1; }
                next
            }
            if (in_preferences && $0 ~ /^WebUI\\LocalHostAuth=/) {
                if (!lha_written) { print "WebUI\\LocalHostAuth=" lha; lha_written = 1; }
                next
            }
            if (in_preferences && wizard_user != "" && $0 ~ /^WebUI\\Username=/) {
                if (!user_written) { print "WebUI\\Username=" wizard_user; user_written = 1; }
                next
            }
            if (in_preferences && wizard_pass != "" && $0 ~ /^WebUI\\Password_PBKDF2=/) {
                if (!pass_written) { print "WebUI\\Password_PBKDF2=" wizard_pass; pass_written = 1; }
                next
            }

            print $0
        }
        END {
            if (in_preferences) {
                if (!alt_written) print "WebUI\\AlternativeUIEnabled=" alt_ui
                if (!addr_written) print "WebUI\\Address=" addr
                if (!lha_written) print "WebUI\\LocalHostAuth=" lha
                if (wizard_user != "" && !user_written) print "WebUI\\Username=" wizard_user
                if (wizard_pass != "" && !pass_written) print "WebUI\\Password_PBKDF2=" wizard_pass
            }
        }
    ' "$CONFIG_FILE" > "$TMP_CONFIG"

    mv "$TMP_CONFIG" "$CONFIG_FILE"
    flock -u 200
    echo "qBittorrent配置文件已更新"
else
    echo "警告：配置文件不存在，将在首次启动时创建"
fi

if [ "$WAS_RUNNING" = true ]; then
    echo "应用之前在运行，正在重启..."
    "$MAIN_SCRIPT" start
    echo "qBittorrent 配置已应用，服务已重启"
else
    echo "应用之前处于停止状态，配置已应用"
fi

exit 0
