#!/bin/bash
# cmd/upgrade_callback - qBittorrent升级回调脚本
# 功能：升级后恢复数据、设置权限、验证配置、启动服务

APP_NAME="qbittorrent"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/qBittorrent/config"
CONFIG_FILE="${CONFIG_DIR}/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
LOCK_FILE="${TRIM_PKGTMP}/${APP_NAME}.upgrade.lock"
MAIN_SCRIPT="/var/apps/qbittorrent/cmd/main"

# 备份在shares目录
SHARE_DIR="/vol1/@appshare/qbittorrent"
BACKUP_DIR="${SHARE_DIR}/.data_backup"

echo "=================================="
echo "qBittorrent 升级完成"
echo "=================================="
echo ""

# 等待升级锁释放（upgrade_init 会释放）
exec 200>"$LOCK_FILE"
flock -w 30 200 || {
    echo "警告：等待升级锁超时，继续执行..."
}

# 设置可执行权限
echo "[1/3] 设置可执行权限..."
chmod +x "$BIN_DIR/qbittorrent-nox" 2>/dev/null || true
chmod +x "$MAIN_SCRIPT" 2>/dev/null || true

# 验证二进制文件
echo "[2/3] 验证新安装..."
if [ -x "$BIN_DIR/qbittorrent-nox" ]; then
    echo "qbittorrent-nox 已找到且可执行"
else
    echo "错误：未找到可执行文件 qbittorrent-nox，路径：$BIN_DIR" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# 恢复数据（如果存在备份）- 必须在配置检查之前执行
echo "[3/3] 检查并恢复数据..."

# 检查是否有备份
BACKUP_EXISTS=false
if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
    BACKUP_EXISTS=true
fi

if [ "$BACKUP_EXISTS" = true ]; then
    # 有备份：直接恢复数据（覆盖新安装的默认配置）
    echo "正在从备份恢复数据..."
    mkdir -p "$DATA_DIR"
    rm -rf "$DATA_DIR"/* 2>/dev/null || true
    cp -a "$BACKUP_DIR"/* "$DATA_DIR/" 2>/dev/null || true
    echo "数据已从共享备份成功恢复"

    # 删除备份
    rm -rf "$BACKUP_DIR"
    echo "备份已清理"
fi

# 确保配置存在（恢复后检查，无数据时创建默认配置）
echo ""
echo "检查配置文件..."

if [ -f "$CONFIG_FILE" ]; then
    echo "使用现有配置: $CONFIG_FILE"
    TMP_UP=$(mktemp)
    awk -v root="${TRIM_APPDEST}/ui/vuetorrent" '
        /^WebUI\\RootFolder=/ { print "WebUI\\RootFolder=" root; next; }
        /^WebUI\\Address=/ { print "WebUI\\Address=127.0.0.1"; next; }
        /^WebUI\\LocalHostAuth=/ { print "WebUI\\LocalHostAuth=false"; next; }
        { print }
    ' "$CONFIG_FILE" > "$TMP_UP"
    mv "$TMP_UP" "$CONFIG_FILE"
else
    # 没有配置文件：检查是否有真实数据
    CONFIG_EXISTS=false
    if [ -d "$DATA_DIR/qBittorrent" ] && [ -n "$(ls -A "$DATA_DIR/qBittorrent" 2>/dev/null)" ]; then
        CONFIG_EXISTS=true
    fi

    if [ "$CONFIG_EXISTS" = true ]; then
        echo "发现现有数据但无配置文件，创建默认配置"
        mkdir -p "$CONFIG_DIR"
        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=127.0.0.1
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
EOF
        echo "默认配置已创建"
    else
        # 没有数据也没有备份：创建默认配置
        echo "无备份且无现有数据，创建默认配置"
        mkdir -p "$CONFIG_DIR"
        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=127.0.0.1
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=@ByteArray(ARQ77eY1NUZaQsuDHbIMCA==:0WMRkYTUWVT9wVvdDtHAjU9b3b7uB8NR1Gur2hmQCvCDpm39Q+PsJRJPaCU51dEiz+dTzh8qbPsL8WkFljQYFQ==)
WebUI\ClickjackingProtection=false
WebUI\CSRFProtection=false
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
EOF
        echo "默认配置已创建"
    fi
fi

# 启动服务
echo ""

# 使用绝对路径启动
if [ -x "$MAIN_SCRIPT" ]; then
    "$MAIN_SCRIPT" start
    EXIT_CODE=$?
else
    echo "错误：未找到主脚本 $MAIN_SCRIPT" > "$TRIM_TEMP_LOGFILE"
    echo "错误：未找到主脚本 main"
    exit 1
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "=================================="
    echo "qBittorrent 升级成功完成！"
    echo "=================================="
    echo ""
    echo "访问信息："
    echo "  WebUI: /app/qbittorrent (via gateway)"
    echo "  用户名: admin"
    echo "  密码: (保持不变)"
    echo ""
    echo "重要提示：如果您更改了 qBittorrent 版本，"
    echo "          某些设置可能需要重新配置。"
    flock -u 200
    exit 0
else
    echo ""
    echo "=================================="
    echo "警告：升级完成但服务启动失败"
    echo "=================================="
    echo "请查看日志: ${TRIM_PKGVAR}/${APP_NAME}.log"
    flock -u 200
    exit 1
fi
