#!/bin/bash
# cmd/upgrade_callback - qBittorrent升级回调脚本
# 功能：升级后恢复数据、设置权限、验证配置、启动服务

APP_NAME="qbittorrent"
CMD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="${TRIM_APPDEST}/bin"
DATA_DIR="${TRIM_PKGVAR}"
CONFIG_DIR="${DATA_DIR}/qBittorrent/config"
CONFIG_FILE="${CONFIG_DIR}/qBittorrent.conf"
PID_FILE="${TRIM_PKGTMP}/${APP_NAME}.pid"
MAIN_SCRIPT="${CMD_DIR}/main"

# 公共锁工具：锁文件位置、僵尸锁清理、退出兜底
# shellcheck source=upgrade_lock.sh
. "${CMD_DIR}/upgrade_lock.sh" 2>/dev/null || {
    echo "错误：缺少锁工具 ${CMD_DIR}/upgrade_lock.sh" > "$TRIM_TEMP_LOGFILE"
    exit 1
}

# 公共的 profile 权限 / 实例锁自愈逻辑（与 cmd/main 共用同一份实现）
# shellcheck source=profile_acl.sh
. "${CMD_DIR}/profile_acl.sh" 2>/dev/null || true

QBT_LOCK_OWNER_TAG="upgrade_callback"

# 备份在shares目录（多卷系统优先使用系统共享路径）
SHARE_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
if [ -z "$SHARE_DIR" ]; then
    SHARE_DIR="/vol1/@appshare/qbittorrent"
fi
BACKUP_DIR="${SHARE_DIR}/.data_backup"

echo "=================================="
echo "qBittorrent 升级完成"
echo "=================================="
echo ""

# 获取升级锁（upgrade_init 正常结束时会已释放，这里只做短暂等待）
# 关键：即使等待失败也继续执行——回调阶段不能因为锁而中断升级收尾，
# 否则会留下"升级完成但服务未启动"的半成品状态。
if ! qbt_lock "qbittorrent.upgrade.lock" 30; then
    echo "警告：等待升级锁超时（持有者 PID: ${QBT_LOCK_BUSY_PID:-未知}），继续执行升级收尾..."
fi

# 设置可执行权限
echo "[1/3] 设置可执行权限..."
chmod +x "$BIN_DIR/qbittorrent-nox" 2>/dev/null || true
chmod +x "$MAIN_SCRIPT" 2>/dev/null || true

# 验证二进制文件
echo "[2/3] 验证新安装..."
if [ -x "$BIN_DIR/qbittorrent-nox" ]; then
    echo "qbittorrent-nox 已找到且可执行"
else
    echo "错误：未找到可执行文件 qbittorrent-nox，路径：$BIN_DIR" > "$TRIM_TEMP_LOGFILE"
    exit 1
fi

# 恢复数据（如果存在备份）- 必须在配置检查之前执行
echo "[3/3] 检查并恢复数据..."

# 检查是否有备份
BACKUP_EXISTS=false
if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
    BACKUP_EXISTS=true
fi

if [ "$BACKUP_EXISTS" = true ]; then
    # 有备份：直接恢复数据（覆盖新安装的默认配置）
    echo "正在从备份恢复数据..."
    mkdir -p "$DATA_DIR"
    # 清空现有内容（含隐藏项），避免新安装的默认配置混入用户数据
    find "$DATA_DIR" -mindepth 1 -maxdepth 1 ! -name '.locks' -exec rm -rf {} + 2>/dev/null || true
    if cp -a "$BACKUP_DIR"/. "$DATA_DIR"/ 2>/dev/null; then
        echo "数据已从共享备份成功恢复"
    else
        # cp 返回非 0 不代表完全失败，逐项确认关键文件
        if [ -f "${DATA_DIR}/qBittorrent/config/qBittorrent.conf" ]; then
            echo "数据已从共享备份恢复（部分文件拷贝告警）"
        else
            echo "错误：数据恢复失败，配置文件未到位" > "$TRIM_TEMP_LOGFILE"
            echo "错误：数据恢复失败"
            exit 1
        fi
    fi

    # 还原权限：备份时为了可读临时改为 700/600，恢复后回到正常值，
    # qBittorrent 首次启动会自行把 config 目录收紧到 000。
    chmod 755 "$DATA_DIR" 2>/dev/null || true
    find "$DATA_DIR/qBittorrent" -type d -exec chmod 750 {} \; 2>/dev/null || true
    find "$DATA_DIR/qBittorrent" -type f -exec chmod 640 {} \; 2>/dev/null || true

    # 删除备份
    rm -rf "$BACKUP_DIR"
    echo "备份已清理"
fi

# 权限自愈：cp -a 会把备份里的 ACL 一起搬回来，其中可能带有
# default:user::---（此后新建的文件属主自己都读不了，典型受害文件是 lockfile，
# 表现为升级后应用启动 1 秒静默退出）；上面的 chmod 只改经典权限位，
# 动不了默认 ACL，所以必须显式修一次。
if declare -F qbt_repair_profile_acls > /dev/null 2>&1; then
    qbt_repair_profile_acls "$DATA_DIR"
else
    echo "警告：缺少 profile_acl.sh，跳过 ACL 修复" > "$TRIM_TEMP_LOGFILE"
fi

# 备份里带回来的 lockfile 记录的是升级前那个已被停掉的 PID，
# 不清理会让 qBittorrent 认为已有实例在跑
if declare -F qbt_clean_profile_lock > /dev/null 2>&1; then
    qbt_clean_profile_lock "$DATA_DIR"
fi

# 确保配置存在（恢复后检查，无数据时创建默认配置）
echo ""
echo "检查配置文件..."

if [ -f "$CONFIG_FILE" ]; then
    echo "使用现有配置: $CONFIG_FILE"
    TMP_UP=$(mktemp)
    awk -v root="${TRIM_APPDEST}/ui/vuetorrent" '
        /^WebUI\\RootFolder=/ { print "WebUI\\RootFolder=" root; next; }
        /^WebUI\\Address=/ { print "WebUI\\Address=0.0.0.0"; next; }
        /^WebUI\\LocalHostAuth=/ { print "WebUI\\LocalHostAuth=false"; next; }
        { print }
    ' "$CONFIG_FILE" > "$TMP_UP"
    mv "$TMP_UP" "$CONFIG_FILE"
else
    # 没有配置文件：检查是否有真实数据
    CONFIG_EXISTS=false
    if [ -d "$DATA_DIR/qBittorrent" ] && [ -n "$(ls -A "$DATA_DIR/qBittorrent" 2>/dev/null)" ]; then
        CONFIG_EXISTS=true
    fi

    if [ "$CONFIG_EXISTS" = true ]; then
        echo "发现现有数据但无配置文件，创建默认配置"
        mkdir -p "$CONFIG_DIR"
        # 随机内部凭证（SSO 网关免密，绝不使用公开默认密码）
        UPGRADE_PASS_HASH=''
        UPGRADE_RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        if [ -n "$UPGRADE_RANDOM_PASS" ] && [ -f "$BIN_DIR/qbt_password.py" ]; then
            UPGRADE_PASS_HASH=$(echo "$UPGRADE_RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        fi
        if [ -z "$UPGRADE_PASS_HASH" ]; then
            echo "错误：无法生成 qBittorrent 内部凭证" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        unset UPGRADE_RANDOM_PASS

        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=${UPGRADE_PASS_HASH}
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
EOF
        unset UPGRADE_PASS_HASH
        echo "默认配置已创建"
    else
        # 没有数据也没有备份：创建默认配置
        echo "无备份且无现有数据，创建默认配置"
        mkdir -p "$CONFIG_DIR"
        UPGRADE_PASS_HASH=''
        UPGRADE_RANDOM_PASS=$(head -c 24 /dev/urandom 2>/dev/null | base64 2>/dev/null | tr -dc 'a-zA-Z0-9' | head -c 24)
        if [ -n "$UPGRADE_RANDOM_PASS" ] && [ -f "$BIN_DIR/qbt_password.py" ]; then
            UPGRADE_PASS_HASH=$(echo "$UPGRADE_RANDOM_PASS" | python3 "$BIN_DIR/qbt_password.py" 2>/dev/null || echo "")
        fi
        if [ -z "$UPGRADE_PASS_HASH" ]; then
            echo "错误：无法生成 qBittorrent 内部凭证" > "$TRIM_TEMP_LOGFILE"
            exit 1
        fi
        unset UPGRADE_RANDOM_PASS

        cat > "$CONFIG_FILE" << EOF
[BitTorrent]
Session\DefaultSavePath=/vol1/@appshare/qbittorrent/downloads/
Session\TempPath=/vol1/@appshare/qbittorrent/temp/
[Preferences]
General\Locale=zh_CN
WebUI\Address=0.0.0.0
WebUI\Port=8080
WebUI\LocalHostAuth=false
WebUI\Username=admin
WebUI\Password_PBKDF2=${UPGRADE_PASS_HASH}
WebUI\AlternativeUIEnabled=true
WebUI\RootFolder=${TRIM_APPDEST}/ui/vuetorrent
EOF
        unset UPGRADE_PASS_HASH
        echo "默认配置已创建"
    fi
fi

# 启动服务
echo ""

# 使用 main 脚本启动（后台启动守护进程，脚本快速退出，子进程被 init 接管）
if [ -x "$MAIN_SCRIPT" ]; then
    "$MAIN_SCRIPT" start
    EXIT_CODE=$?
else
    echo "错误：未找到主脚本 $MAIN_SCRIPT" > "$TRIM_TEMP_LOGFILE"
    echo "错误：未找到主脚本 main"
    exit 1
fi

if [ $EXIT_CODE -eq 0 ]; then
    echo ""
    echo "=================================="
    echo "qBittorrent 升级成功完成！"
    echo "=================================="
    echo ""
    echo "访问信息："
    echo "  WebUI: /app/qbittorrent (via gateway)"
    echo "  用户名: admin"
    echo "  密码: (保持不变)"
    echo ""
    echo "重要提示：如果您更改了 qBittorrent 版本，"
    echo "          某些设置可能需要重新配置。"
    qbt_unlock
    exit 0
else
    echo ""
    echo "=================================="
    echo "警告：升级完成但服务启动失败"
    echo "=================================="
    echo "请查看日志: ${TRIM_PKGVAR}/${APP_NAME}.log"
    qbt_unlock
    exit 1
fi
