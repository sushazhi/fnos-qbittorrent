#!/bin/bash
# cmd/install_init - qBittorrent安装初始化脚本
# 功能：验证安装前的必要条件

echo "qBittorrent install_init started"

# 获取下载目录配置
SAVE_PATH="${wizard_save_path:-/vol1/1000/downloads/}"

echo "Checking save path: $SAVE_PATH"

# 验证下载目录是否存在
if [ ! -d "$SAVE_PATH" ]; then
    echo "错误：下载目录（$SAVE_PATH）不存在" > "$TRIM_TEMP_LOGFILE"
    echo "请在 fnOS 文件管理中创建该目录后重试" >> "$TRIM_TEMP_LOGFILE"
    exit 1
fi

echo "Save path validation passed"
echo "qBittorrent install_init completed"
exit 0
