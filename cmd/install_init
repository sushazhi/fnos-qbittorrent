#!/bin/bash
# cmd/install_init - qBittorrent安装初始化脚本

set -u

echo "qBittorrent install_init started"

log_error() {
    local msg="$1"
    echo "$msg"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$msg" > "$TRIM_TEMP_LOGFILE"
    fi
}

SAVE_PATH="${wizard_save_path:-/vol1/@appshare/qbittorrent/downloads/}"

echo "Checking save path: $SAVE_PATH"

if echo "$SAVE_PATH" | grep -qE '^/vol[0-9]+/@appshare/'; then
    echo "Save path is under @appshare, will be created on startup"
else
    if [ ! -d "$SAVE_PATH" ]; then
        log_error "错误：下载目录（$SAVE_PATH）不存在，请先在 fnOS 文件管理中创建后重试"
        exit 1
    fi
fi

echo "Pre-install validation passed"
echo "qBittorrent install_init completed"
exit 0
